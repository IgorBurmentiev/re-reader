---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  img?: ImageMetadata;
  size?: "sm" | "md" | "lg";
}
const { img, size = "md" } = Astro.props;
// Картинка кроется по центру с лёгким смещением вверх (там обычно лица).
// Пропорции разные — берём разумную высоту и небольшую обрезку, без полос.
---

<div class:list={["hero", `s-${size}`, { plain: !img }]}>
  {
    img && (
      <Image
        class="bg"
        src={img}
        alt=""
        widths={[640, 1024, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    )
  }
  <div class="grad"></div>
  <div class="in"><slot /></div>
</div>

<style>
  .hero {
    position: relative;
    display: grid;
    place-content: center;
    text-align: center;
    overflow: hidden;
    isolation: isolate;
    border-radius: 12px;
    padding: clamp(32px, 6vw, 72px) clamp(20px, 5vw, 56px);
  }
  .s-sm { min-height: clamp(160px, 22vh, 240px); }
  .s-md { min-height: clamp(220px, 34vh, 360px); }
  .s-lg { min-height: clamp(300px, 54vh, 540px); }
  .hero.plain {
    background: radial-gradient(
      130% 130% at 50% 0%,
      color-mix(in srgb, var(--c) 24%, var(--paper)) 0%,
      var(--paper) 72%
    );
  }
  .bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 32%;
  }
  .grad {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--paper) 40%, transparent) 0%,
      color-mix(in srgb, var(--paper) 12%, transparent) 42%,
      color-mix(in srgb, var(--paper) 78%, transparent) 82%,
      var(--paper) 100%
    );
  }
  .in { position: relative; max-width: 46rem; }
</style>
