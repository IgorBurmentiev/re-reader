---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  img?: ImageMetadata;
  alt?: string;
  /** запасной текст в градиентной заглушке */
  fallback?: string;
}
const { img, alt = "", fallback = "" } = Astro.props;
// Карточка: умеренная обрезка по центру допустима (ТЗ). Жёсткого размера нет —
// контейнер задаёт пропорцию-подсказку, картинка кроется по центру.
---

<div class="cover">
  {
    img ? (
      <Image
        src={img}
        alt={alt}
        widths={[280, 420, 560]}
        sizes="(max-width: 640px) 92vw, 280px"
        loading="lazy"
      />
    ) : (
      <span class="ph">{fallback}</span>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 3 / 2;
    background: color-mix(in srgb, var(--c) 14%, var(--paper-2));
    overflow: hidden;
  }
  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    padding: 12px;
    text-align: center;
    font: 12px "Golos Text", sans-serif;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--c) 70%, var(--ink-dim));
    background: linear-gradient(
      140deg,
      color-mix(in srgb, var(--c) 20%, var(--paper-2)),
      var(--paper-2)
    );
  }
</style>
