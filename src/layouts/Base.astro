---
import Icon from "../components/Icon.astro";
import PalettePanel from "../components/PalettePanel.astro";
import { GFONTS_HREF } from "../lib/fonts";

interface Props {
  title: string;
  /** тема-по-умолчанию для этой страницы (арка/глава); пользователь может переопределить */
  theme?: string;
  wide?: boolean;
  /** показывать общий FAB-палитры (на страницах читалки — свой набор кнопок) */
  palette?: boolean;
  bare?: boolean; // без хедера/подвала (для читалки)
  /** ссылка «‹ назад» в фиксированном хедере (на место таглайна) — тот же уровень
      вложенности, что и «крумба» в самом верху страницы, но доступна из любого
      места после прокрутки (как в читалке), а не только пока не проскроллил вниз */
  backHref?: string;
  backLabel?: string;
}
const {
  title,
  theme = "midnight",
  wide = false,
  palette = true,
  bare = false,
  backHref,
  backLabel,
} = Astro.props;
---

<!doctype html>
<html lang="ru" data-mode="dark" data-theme={theme} data-arc-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="theme-color" content="#0b0e18" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={GFONTS_HREF} rel="stylesheet" />
    <script is:inline>
      // применяем сохранённую тему до отрисовки — без вспышки
      try {
        var s = JSON.parse(localStorage.getItem("rz:site") || "{}");
        var el = document.documentElement;
        var arc = el.dataset.arcTheme || "midnight";
        var id = s.auto === "off" && s.theme ? s.theme : arc;
        el.dataset.theme = id;
      } catch (e) {}
    </script>
    <style is:global>
      /* шрифты Windows — файлами не раздаём, берём с машины пользователя */
      @font-face { font-family: "InkFreeLocal"; src: local("Ink Free"), local("InkFree"); font-display: swap; }
      @font-face { font-family: "SegoeScriptLocal"; src: local("Segoe Script"); font-display: swap; }
      @font-face { font-family: "MistralLocal"; src: local("Mistral"); font-display: swap; }

      :root {
        --paper: #0b0e18;
        --paper-2: #111524;
        --ink: #d9d6cd;
        --ink-dim: #8d8a84;
        --gold: #c9a227;
        --gold-soft: #e0c56a;
        --rule: rgba(201, 162, 39, 0.18);
        --c: var(--gold);
        --measure: 1180px;
        --shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.9);
        --ui: "Golos Text", system-ui, sans-serif;
        --nav: 13px;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        /* тёмное полотно + мягкая цветная дымка сверху — сама тема должна быть
           заметна не только по тонким контурам, но и по общей атмосфере страницы */
        background:
          radial-gradient(70% 50% at 50% -10%, color-mix(in srgb, var(--c) 13%, transparent), transparent 70%),
          var(--paper);
        color: var(--ink);
        font: 18px/1.7 "EB Garamond", Georgia, serif;
        -webkit-font-smoothing: antialiased;
        overflow-wrap: anywhere;
        transition: background 0.4s, color 0.4s;
      }
      a { color: inherit; text-decoration: none; }
      img { display: block; max-width: 100%; height: auto; }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
      code {
        font-size: 0.85em;
        background: color-mix(in srgb, var(--c) 10%, var(--paper-2));
        padding: 1px 5px;
        border-radius: 3px;
      }
      @media (prefers-reduced-motion: reduce) {
        *, ::view-transition-group(*) {
          transition: none !important;
          animation: none !important;
        }
      }
      header.site {
        position: fixed;
        inset: 0 0 auto 0;
        height: 50px;
        z-index: 40;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 0 22px;
        font: 500 var(--nav) / 1 var(--ui);
        letter-spacing: 0.06em;
        color: var(--ink-dim);
        background: color-mix(in srgb, var(--paper) 84%, transparent);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--rule);
      }
      header.site b {
        color: var(--c);
        font-weight: 600;
        letter-spacing: 0.14em;
      }
      header.site .mid { flex: 1; }
      header.site .back {
        flex: 1;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: var(--ink-dim);
        font: inherit;
      }
      header.site .back:hover { color: var(--c); }
      header.site .ic { display: inline-flex; color: var(--ink-dim); }
      header.site .ic:hover { color: var(--c); }
      @media (max-width: 560px) { header.site .mid { display: none; } }
      main {
        max-width: var(--measure);
        margin: 0 auto;
        padding: 74px clamp(16px, 4vw, 40px) 120px;
      }
      main.wide { max-width: 1320px; }
      main.bare { padding: 0; max-width: none; }
      footer.site {
        border-top: 1px solid var(--rule);
        padding: 40px 24px 72px;
        text-align: center;
        font: 500 13px var(--ui);
        color: var(--ink-dim);
        line-height: 1.9;
      }
      footer.site b { color: var(--ink); font-weight: 500; }
      @view-transition { navigation: auto; }
      ::view-transition-old(root),
      ::view-transition-new(root) { animation-duration: 0.26s; }
      .sw-toast {
        position: fixed;
        left: 50%;
        bottom: 18px;
        transform: translateX(-50%);
        z-index: 70;
        background: var(--paper-2);
        border: 1px solid var(--c);
        border-radius: 6px;
        padding: 10px 16px;
        font: 500 13px var(--ui);
        color: var(--ink);
        box-shadow: var(--shadow);
      }
      .sw-toast button {
        margin-left: 10px;
        background: var(--c);
        color: var(--paper);
        border: 0;
        border-radius: 4px;
        padding: 4px 10px;
        font: inherit;
        cursor: pointer;
      }

      /* тост «Открыто в Дополнительно» — угол справа снизу, растёт вниз
         (несколько строк названий), а не вширь; см. src/lib/unlockToast.ts.
         Не показывается в читалке — там его просто никто не вызывает. */
      .unlock-toast {
        position: fixed;
        right: 22px;
        bottom: 22px;
        z-index: 70;
        max-width: 320px;
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 14px 16px;
        background: var(--paper-2);
        border: 1px solid var(--c);
        border-radius: 10px;
        box-shadow: var(--shadow);
        transform: translateY(14px);
        opacity: 0;
        pointer-events: none;
        transition: 0.35s;
      }
      .unlock-toast.show { transform: none; opacity: 1; pointer-events: auto; }
      .unlock-toast .ic { color: var(--c); flex: none; margin-top: 2px; }
      .unlock-toast b {
        display: block;
        font: 600 12px var(--ui);
        letter-spacing: 0.04em;
        color: var(--gold-soft);
        margin-bottom: 3px;
      }
      .unlock-toast p { margin: 0 0 6px; font-size: 13.5px; font-style: italic; line-height: 1.4; }
      .unlock-toast a {
        font: 500 11.5px var(--ui);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--c);
      }
      .unlock-toast a:hover { text-decoration: underline; }
      @media (max-width: 480px) {
        .unlock-toast { right: 12px; left: 12px; max-width: none; bottom: 12px; }
      }
    </style>
  </head>
  <body>
    {
      !bare && (
        <header class="site">
          <a href="/"><b>RE:ZERO</b></a>
          {
            backHref ? (
              <a class="back" href={backHref}>
                <Icon name="chevron-left" size={13} /> {backLabel}
              </a>
            ) : (
              <span class="mid">полное собрание · веб-новелла + ранобэ</span>
            )
          }
          <a class="ic" href="/search" aria-label="Поиск">
            <Icon name="search" size={18} />
          </a>
        </header>
      )
    }
    <main class:list={[{ wide, bare }]}>
      <slot />
    </main>

    {palette && <PalettePanel />}

    <script>
      import "../scripts/theme.ts";
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () =>
          navigator.serviceWorker.register("/sw.js").catch(() => {}),
        );
        let refreshing = false;
        navigator.serviceWorker.addEventListener("message", (e) => {
          if (e.data?.type === "sw-updated" && !refreshing) {
            const bar = document.createElement("div");
            bar.className = "sw-toast";
            bar.innerHTML = "Обновление контента загружено — <button>обновить</button>";
            bar.querySelector("button")?.addEventListener("click", () => {
              refreshing = true;
              location.reload();
            });
            document.body.appendChild(bar);
            setTimeout(() => bar.remove(), 12000);
          }
        });
      }
    </script>
  </body>
</html>
